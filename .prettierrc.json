{
  "$schema": "https://json.schemastore.org/prettierrc",
  "printWidth": 100,
  "embeddedLanguageFormatting": "off",
  "plugins": ["prettier-plugin-sql-cst"],
  "overrides": [
    {
      "files": "*.sql",
      "options": {
        "parser": "sqlite",
        "sqlCanonicalSyntax": false,
        "sqlKeywordCase": "preserve",
        "sqlLiteralCase": "preserve",
        "sqlTypeCase": "preserve"
      }
    }
  ]
}
