{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "officeflare",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-29",
	"workers_dev": true,
	"assets": {
		"directory": "./dist/client",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api", "/api/*"]
	},
	"vars": {
		"AUTH_ISSUER": "officeflare",
		"AUTH_AUDIENCE": "officeflare-api"
	},
	"secrets": {
		"required": ["AUTH_SIGNING_KEYS", "MFA_ENCRYPTION_KEYS"]
	},
	"observability": {
		"enabled": true
	},
	"dev": {
		"ip": "127.0.0.1",
		"port": 8787
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "officeflare-user-accounts"
		}
	]
}
