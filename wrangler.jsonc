{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "officeflare",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-29",
	"workers_dev": true,
	"assets": {
		"directory": "./dist/client",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api", "/api/*", "/.well-known/jmap", "/jmap", "/jmap/*", "/mcp"]
	},
	"vars": {
		"AUTH_ISSUER": "officeflare",
		"AUTH_AUDIENCE": "officeflare-api",
		"NOTIFICATION_QUEUE_NAME": "officeflare-notifications",
		"DRIVE_QUOTA_BYTES": "10737418240",
		"MAIL_PARTITION_TARGET_BYTES": "6000000000"
	},
	"secrets": {
		"required": ["AUTH_SIGNING_KEYS", "MFA_ENCRYPTION_KEYS"]
	},
	"observability": {
		"enabled": true
	},
	"dev": {
		"ip": "127.0.0.1",
		"port": 8787
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "officeflare-user-accounts"
		}
	],
	"durable_objects": {
		"bindings": [
			{ "name": "MAILBOX", "class_name": "MailboxDO" },
			{ "name": "MAIL_PARTITION", "class_name": "MailPartitionDO" },
			{ "name": "NOTIFICATION_HUB", "class_name": "NotificationHubDO" }
		]
	},
	"migrations": [
		{ "tag": "mail-v1", "new_sqlite_classes": ["MailboxDO", "MailPartitionDO"] },
		{ "tag": "notifications-v1", "new_sqlite_classes": ["NotificationHubDO"] }
	],
	"r2_buckets": [
		{ "binding": "MAIL_BUCKET", "bucket_name": "officeflare-mail" },
		{ "binding": "PROFILE_BUCKET", "bucket_name": "officeflare-profiles" },
		{ "binding": "DRIVE_BUCKET", "bucket_name": "officeflare-drive" }
	],
	"send_email": [{ "name": "EMAIL" }],
	"queues": {
		"producers": [
			{ "binding": "MAIL_QUEUE", "queue": "officeflare-mail" },
			{ "binding": "NOTIFICATION_QUEUE", "queue": "officeflare-notifications" }
		],
		"consumers": [
			{ "queue": "officeflare-mail", "max_batch_size": 10, "max_retries": 5, "dead_letter_queue": "officeflare-mail-dlq" },
			{ "queue": "officeflare-notifications", "max_batch_size": 100, "max_retries": 5, "dead_letter_queue": "officeflare-notifications-dlq" }
		]
	},
	"triggers": { "crons": ["*/5 * * * *"] },
	"rules": [{ "type": "Text", "globs": ["**/mail/*.sql"], "fallthrough": true }]
}
