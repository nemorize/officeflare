{
  "name": "officeflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "사용자 계정 기본 정보를 저장하는 D1 데이터베이스입니다."
      }
    }
  },
  "scripts": {
    "dev": "vite",
    "cf-typegen": "wrangler types",
    "typecheck": "npm run cf-typegen && tsc --noEmit && tsc --project tsconfig.web.json",
    "build:web": "vite build",
    "build": "npm run build:web && wrangler deploy --dry-run --outdir dist",
    "preview": "wrangler dev",
    "check": "npm run typecheck && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "node --experimental-strip-types scripts/deploy.mjs",
    "tail": "wrangler tail",
    "prepare": "npm run cf-typegen",
    "auth:keys": "node scripts/generate-auth-keys.mjs",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs"
  },
  "overrides": {
    "undici": "7.29.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.60.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "miniflare": "5.20260926.0-alpha",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "wrangler": "4.143.0"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.12",
    "jose": "6.2.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4"
  }
}
