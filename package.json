{
  "name": "officeflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "사용자 계정 기본 정보를 저장하는 D1 데이터베이스입니다."
      }
    }
  },
  "scripts": {
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:staged": "lint-staged",
    "cf-typegen": "wrangler types",
    "typecheck": "npm run cf-typegen && tsc --noEmit && tsc --project tsconfig.web.json",
    "build:web": "vite build",
    "build": "npm run build:web && wrangler deploy --dry-run --outdir dist",
    "preview": "wrangler dev",
    "check": "npm run format:check && npm run typecheck && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "node --experimental-strip-types scripts/deploy.mjs",
    "tail": "wrangler tail",
    "prepare": "husky && npm run cf-typegen",
    "auth:keys": "node scripts/generate-auth-keys.mjs",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs"
  },
  "overrides": {
    "undici": "7.29.1"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.60.0",
    "@types/css-tree": "3.2.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.28.1",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "miniflare": "5.20260926.0-alpha",
    "prettier": "3.9.10",
    "prettier-plugin-sql-cst": "0.23.1",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "wrangler": "4.143.0"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@js-temporal/polyfill": "0.5.1",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-text-align": "3.31.4",
    "@tiptap/extension-text-style": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "css-tree": "3.1.0",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.12",
    "htmlparser2": "12.0.0",
    "ical.js": "2.2.1",
    "image-size": "2.0.2",
    "ipaddr.js": "2.2.0",
    "jose": "6.2.12",
    "pdfjs-dist": "6.4.299",
    "postal-mime": "4.0.4",
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4",
    "rrule": "2.8.1",
    "sanitize-html": "2.18.0"
  }
}
